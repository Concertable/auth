<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Aspire.AppHost.Sdk" Version="13.3.2" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>auth-apphost-dev-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Concertable.AppHost.Shared" />
    <ProjectReference Include="..\..\api\src\Concertable.Auth.Hosting\Concertable.Auth.Hosting.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\api\src\Concertable.Auth\Concertable.Auth.csproj" />
    <ProjectReference Include="..\..\api\src\Concertable.Auth.Migrations\Concertable.Auth.Migrations.csproj" />
  </ItemGroup>

</Project>
