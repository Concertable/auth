<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ContainerRepository>concertable/auth</ContainerRepository>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" />
    <PackageReference Include="Duende.IdentityServer" />
    <PackageReference Include="Duende.IdentityServer.EntityFramework" />
    <PackageReference Include="Dunet" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Refit.HttpClientFactory" />
    <PackageReference Include="Reunion" />
    <PackageReference Include="Reunion.Errors" />
  </ItemGroup>

  <!-- Shared platform stays on feed packages; Auth.Contracts is owned by this repository. -->
  <ItemGroup>
    <ProjectReference Include="..\Concertable.Auth.Contracts\Concertable.Auth.Contracts.csproj" />
    <PackageReference Include="Concertable.Kernel" />
    <PackageReference Include="Concertable.Seed.Shared" />
    <PackageReference Include="Concertable.Seed.Identity" />
    <PackageReference Include="Concertable.DataAccess.Application" />
    <PackageReference Include="Concertable.DataAccess.Infrastructure" />
    <PackageReference Include="Concertable.Messaging.AzureServiceBus" />
    <PackageReference Include="Concertable.ServiceDefaults" />
    <PackageReference Include="Concertable.Messaging.Infrastructure" />
    <PackageReference Include="Concertable.Shared.Blob.Infrastructure" />
    <PackageReference Include="Concertable.Shared.Email.Infrastructure" />
    <PackageReference Include="Concertable.Shared.Geocoding.Infrastructure" />
    <PackageReference Include="Concertable.Shared.Imaging.Infrastructure" />
    <PackageReference Include="Concertable.Shared.Pdf.Infrastructure" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Concertable.Auth.IntegrationTests.Fixtures" />
    <InternalsVisibleTo Include="Concertable.Auth.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.E2E.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
