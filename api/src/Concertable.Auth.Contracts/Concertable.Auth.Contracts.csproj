<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <Description>Concertable Auth service contracts: cross-service integration events and DTOs published by Auth and consumed by other services.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Concertable.Messaging.Contracts" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Concertable.Auth.Contracts.UnitTests" />
  </ItemGroup>

  <!-- tests/ holds this package's own unit-test project; it must not compile into the package. -->
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <None Remove="tests/**/*" />
  </ItemGroup>

</Project>
